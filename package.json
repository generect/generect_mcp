{
  "name": "generect-ultimate-mcp",
  "version": "0.5.4",
  "type": "module",
  "description": "Minimal MCP server exposing Generect Live API tools.",
  "license": "MIT",
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generect/generect_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/generect/generect_mcp/issues"
  },
  "homepage": "https://github.com/generect/generect_mcp#readme",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/http.js",
    "mcp:client": "tsx scripts/mcp-client.ts",
    "health": "tsx scripts/health.ts",
    "probe": "tsx scripts/probe.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check-version": "node scripts/check-version.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\""
  },
  "bin": {
    "generect-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.1.3",
    "undici": "^6.27.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.19.17",
    "prettier": "^3.8.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
